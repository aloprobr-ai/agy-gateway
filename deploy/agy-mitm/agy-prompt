#!/bin/sh
# Кому из клиентов шлюза можно самим выключать промпт agy — обёртка над
# bin/agy-prompt.php шлюза, там же описание:
#   agy-prompt                     кому разрешено и кто выключил
#   agy-prompt on all | off all    разрешить или запретить всем
#   agy-prompt on|off|default <ключ, его начало или имя> ...
# Лицензия: MIT с условием Commons Clause (продавать нельзя) — см. LICENSE.
UNIT=/etc/systemd/system/agy-mitm.service
if [ -f "$UNIT" ]; then
    [ -z "$GATEWAY" ] && GATEWAY=$(sed -nE 's/^Environment=GATEWAY=(.*)$/\1/p' "$UNIT" | tail -1)
    [ -z "$PHP" ] && PHP=$(sed -nE 's/^Environment=PHP=(.*)$/\1/p' "$UNIT" | tail -1)
fi
GATEWAY=${GATEWAY:-/var/www/agy-gateway}
PHP=${PHP:-php}

# Файл пишет и шлюз из-под своего пользователя — запускаем от него же,
# иначе после первой правки отсюда шлюз не сможет его перезаписать.
OWNER=$(stat -c %U "$GATEWAY/storage")
if [ "$(id -un)" = "$OWNER" ]; then
    exec "$PHP" "$GATEWAY/bin/agy-prompt.php" "$@"
fi
exec runuser -u "$OWNER" -- "$PHP" "$GATEWAY/bin/agy-prompt.php" "$@"
