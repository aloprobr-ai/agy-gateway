[Unit]
Description=Перехватчик agy: вырезает системный промпт agy из запросов к модели
After=network-online.target

[Service]
# Каталог шлюза и PHP (в aaPanel, например, /www/server/php/81/bin/php).
Environment=GATEWAY=/var/www/agy-gateway
Environment=PHP=php
ExecStart=/opt/agy-mitm/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
