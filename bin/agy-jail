#!/bin/sh
#
# Песочница для Antigravity CLI (только Linux).
#
# Шлюз запускает CLI с ключом --dangerously-skip-permissions: иначе тот на
# каждое действие ждёт ответа человека, а человека у HTTP-запроса нет. Но
# «не спрашивать» не должно значить «можно всё»: без ограничений модель
# гуляет по всему диску сервера — читает чужие сайты, конфиги, ключи.
#
# Поэтому запуск происходит в своём пространстве монтирования, где системные
# каталоги накрыты пустыми tmpfs только для чтения. Внутри они выглядят
# пустыми, снаружи ничего не меняется: пространство исчезает вместе
# с процессом, и на саму машину это не влияет никак.
#
# Видимыми остаются дом CLI (там авторизация и беседы) и рабочий каталог,
# который шлюз заводит для каждой беседы отдельно.
#
# Что нужно: unshare из util-linux и разрешённые непривилегированные
# пространства имён (обычно включены; проверить —
# `sysctl kernel.unprivileged_userns_clone`, должно быть 1).
#
# Вызов: bin/agy-jail /путь/к/agy <аргументы>
#
# Список пряток можно поменять переменной AGY_JAIL_HIDE (через пробел).
set -eu

if [ "$#" -eq 0 ]; then
    echo "agy-jail: нечего запускать" >&2
    exit 2
fi

# Имя программы разворачиваем в полный путь ЗДЕСЬ, снаружи песочницы.
# Внутри поиск по PATH может не удаться: каталог с программой к тому времени
# уже накрыт пустой tmpfs, и вместо работы выйдет «command not found».
target=$1
case "$target" in
    */*) ;;
    *)   target=$(command -v "$target" 2>/dev/null) || target=$1 ;;
esac
# И разворачиваем ссылки: /usr/bin/php нередко ведёт куда-нибудь в /www, и
# прятать надо не саму ссылку, а тот каталог, где лежит настоящий файл.
target=$(readlink -f "$target" 2>/dev/null || echo "$target")
shift
set -- "$target" "$@"

: "${AGY_JAIL_HIDE:=/boot /etc/nginx /lost+found /media /mnt /opt /srv /var /www /root}"

# То, без чего запуск не состоится: сама программа и текущий каталог.
# Спрятать их — значит запереть дверь вместе с ключом внутри.
AGY_JAIL_KEEP="$target $PWD"

export AGY_JAIL_HIDE AGY_JAIL_KEEP

exec unshare --mount --map-root-user --propagation private /bin/sh -c '
    for d in $AGY_JAIL_HIDE; do
        # Каталог, которого нет, пропускаем молча — списки у всех разные.
        [ -d "$d" ] || continue

        skip=
        for keep in $AGY_JAIL_KEEP; do
            case "$keep" in
                "$d"|"$d"/*) skip=1 ;;
            esac
        done
        [ -z "$skip" ] || continue

        # Ошибку монтирования не считаем смертельной: лучше запустить
        # с частичной защитой, чем не ответить человеку совсем. Что защиты
        # нет вовсе, шлюз скажет отдельно — в /health.
        mount -t tmpfs -o ro,mode=555,size=4k agy-jail "$d" 2>/dev/null || true
    done
    exec "$@"
' agy-jail "$@"
